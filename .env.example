# Service de prevision : entraine un modele par site et ecrit des previsions en base.
# enervision-devops/compose/ml.yml ne fixe que DATABASE_URL ; tout le reste a un
# defaut, le compose reste valide sans etre modifie.

LOG_LEVEL=INFO
LOG_AS_JSON=true

# Base de destination, aussi la source d'entrainement par defaut. Les schemas
# postgres:// et postgresql:// sont acceptes.
DATABASE_URL=postgres://CHANGEME:CHANGEME@CHANGEME:5432/g4_db

# database (historique lu dans measure_imputed) ou csv (fichier local, utile hors
# infrastructure : entrainement, evaluation).
TRAINING_SOURCE=database
# Obligatoire si TRAINING_SOURCE=csv.
#CSV_PATH=
# Fuseau des horodatages du CSV quand ils sont naifs. La base est en UTC ; un CSV
# genere en heure locale entrainerait le modele sur un calendrier decale.
CSV_SOURCE_TIMEZONE=UTC

# Cadence de la boucle du conteneur (commande "forecast", sans --once).
FORECAST_INTERVAL_SECONDS=3600
# Nombre d'heures de prevision ecrites par site a chaque lot.
HORIZON_HOURS=24
# Historique minimal exige avant d'entrainer un site. En dessous, le site est
# journalise et ignore, la boucle continue.
MIN_TRAINING_HOURS=168
# Fraction de capacity_kw au-dela de laquelle une prevision declenche une
# recommandation. Repli sur le 95e centile de l'historique si la capacite est
# inconnue.
THRESHOLD_RATIO=0.85

# Serveur de suivi MLflow (metriques d'evaluation uniquement, aucun artefact de
# modele). Absent ou vide : evaluate continue de fonctionner normalement, la
# journalisation est simplement desactivee. Volontairement lue en dehors de
# ForecastSettings : evaluate --source csv doit rester utilisable sans aucune
# variable d'environnement, y compris sans DATABASE_URL.
#MLFLOW_TRACKING_URI=
